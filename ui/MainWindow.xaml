<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartClean — диски, порядок и история" Width="1320" Height="900" MinWidth="760" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E7EDF8"/><Setter Property="Foreground" Value="#172B4D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#CFD8E5"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5"/><Setter Property="AlternatingRowBackground" Value="#F7F9FC"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE5EF"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="RowHeight" Value="32"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="Normal"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5F9">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#152A4B" Padding="22,12">
   <DockPanel><StackPanel><TextBlock Text="SmartClean" FontSize="26" FontWeight="Bold" Foreground="White"/><TextBlock Text="Ваши диски. Понятные решения. Проверенные действия." Foreground="#B8C9E3"/></StackPanel><TextBlock Text="WINDOWS • ЛОКАЛЬНО" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B8C9E3" FontSize="12"/></DockPanel>
  </Border>
  <WrapPanel Grid.Row="1" Margin="18,10">
   <Button Name="RefreshButton" Content="Обновить обзор"/><Button Name="CancelButton" Content="Остановить" IsEnabled="False"/>
   <ComboBox Name="SnapshotPicker" MinWidth="180" MaxWidth="440" DisplayMemberPath="Label" Margin="8,0"/>
   <Button Name="AnalyzeButton" Content="Разобрать замер"/><Button Name="ReportButton" Content="Текст отчёта"/>
  </WrapPanel>
  <TabControl Name="Tabs" Grid.Row="2" Margin="18,0,18,12" Background="White" BorderBrush="#DFE5EF">
   <TabItem Name="OverviewTab" Header="Обзор"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button Name="PickScanRoot" Content="Папка…"/><TextBox Name="ScanRootBox" Width="350"/><Button Name="ScanButton" Content="Новый скан" Background="#2563CF" Foreground="White"/><TextBlock Text="Сканирование читает данные; ничего не удаляет." VerticalAlignment="Center" Foreground="#52647F"/></WrapPanel>
    <DataGrid Name="VolumesGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Том" Binding="{Binding DriveLetter}" Width="70"/><DataGridTextColumn Header="Имя" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="ФС" Binding="{Binding FileSystem}" Width="90"/><DataGridTextColumn Header="Всего, GiB" Binding="{Binding TotalGiB}" Width="120"/><DataGridTextColumn Header="Свободно, GiB" Binding="{Binding FreeGiB}" Width="140"/><DataGridTextColumn Header="Носитель" Binding="{Binding Medium}" Width="160"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" Text="Сохранённые карты всех дисков — смотрите дату замера; свободное место выше актуально" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,10"/>
    <TabControl Grid.Row="3" Background="White">
     <TabItem Header="Крупнейшие ветки">    <DataGrid Name="FocusGrid"><DataGrid.Columns><DataGridTextColumn Header="GiB" Binding="{Binding GiB}" Width="85"/><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="Назначение" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Замер, UTC" Binding="{Binding ScanLabel}" Width="105"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Name="BrowseTab" Header="Сохранённая ветка"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Name="BrowseSelectedButton" Content="Открыть выбранный замер"/><Button Name="BrowseUpButton" Content="Вверх"/><Button Name="RefreshBranchButton" Content="Новый замер этой ветки"/><ComboBox Name="BrowseMetric" SelectedIndex="0"><ComboBoxItem Content="Занято"/><ComboBoxItem Content="Логический размер"/></ComboBox></WrapPanel>
      <StackPanel Grid.Row="1" Margin="0,8">
       <WrapPanel Name="BrowseBreadcrumbs"/>
       <TextBox Name="BrowsePath" IsReadOnly="True" TextWrapping="Wrap"/>
      </StackPanel>
      <DataGrid Name="BrowseGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="GiB" Binding="{Binding GiB}" Width="90"/><DataGridTextColumn Header="Путь — дважды нажмите для раскрытия" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Файлов" Binding="{Binding Files}" Width="90"/></DataGrid.Columns></DataGrid>
     </Grid></TabItem>
    </TabControl>
   </Grid></TabItem>
   <TabItem Name="GrowthTab" Header="Рост"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="Было" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Name="BeforePicker" Width="360" DisplayMemberPath="Label"/><TextBlock Text="Стало" Margin="14,0,8,0" VerticalAlignment="Center"/><ComboBox Name="AfterPicker" Width="360" DisplayMemberPath="Label"/><Button Name="CompareButton" Content="Сравнить" Margin="12,0,0,0"/></WrapPanel>
    <StackPanel Grid.Row="1"><WrapPanel><Button Name="GrowthUpButton" Content="Все изменения"/><TextBlock Name="GrowthScope" Text="Все ветки" TextWrapping="Wrap"/></WrapPanel><TextBlock Name="GrowthHint" Text="Нужны два замера одного диска с одинаковой областью и правилами. Повторяйте скан раз в неделю." TextWrapping="Wrap" Margin="0,14" Foreground="#52647F"/></StackPanel>
    <DataGrid Name="ChangesGrid" Grid.Row="2"><DataGrid.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True"><Expander.Header><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTextColumn Header="Было, MiB" Binding="{Binding BeforeMiB}" Width="110"/><DataGridTextColumn Header="Стало, MiB" Binding="{Binding AfterMiB}" Width="110"/><DataGridTextColumn Header="Изменение, MiB" Binding="{Binding DeltaMiB}" Width="160"/><DataGridTextColumn Header="Папка" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Наблюдение" Binding="{Binding Observation}" Width="180"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Name="CleanupTab" Header="Очистка"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><Button Name="CandidatesButton" Content="Найти кандидатов"/><Button Name="CleanupPlanButton" Content="План для отмеченных"/><Button Name="RepeatPermissionButton" Content="Разрешить повтор на 30 дней"/><Separator/><Button Name="PurgeButton" Content="Подготовить безвозвратное удаление из карантина" Foreground="#A4262C"/></WrapPanel>
    <TextBlock Grid.Row="1" Margin="0,12" TextWrapping="Wrap" Foreground="#52647F" Text="Отметьте категории. План заново проверит файлы. Очистка переносит их в карантин; свежие/занятые файлы и данные Claude/Codex не трогаются. Безвозвратное удаление карантина — отдельный план."/>
    <DataGrid Name="CandidatesGrid" Grid.Row="2" IsReadOnly="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="Категория" Binding="{Binding Title}" Width="180" IsReadOnly="True"/><DataGridTextColumn Header="MiB" Binding="{Binding MiB}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Последствия" Binding="{Binding Consequence}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Name="DuplicatesTab" Header="Дубли">
    <Grid Margin="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel>
      <Label Content="Папки для поиска, по одной в строке" Target="{Binding ElementName=DuplicateRootsBox}"/>
      <TextBox Name="DuplicateRootsBox" Height="52" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
      <WrapPanel Margin="0,8,0,0">
       <Button Name="PickDuplicateRoot" Content="Добавить папку…"/>
       <Button Name="DuplicatesButton" Content="Новый поиск"/>
       <Button Name="DuplicateResumeButton" Content="Продолжить сравнение"/>
       <CheckBox Name="DuplicateCrossVolume" Content="Только между томами" VerticalAlignment="Center" Margin="0,0,12,0"/>
       <Button Name="DuplicateFilterButton" Content="Показать группы"/>
       <Button Name="DuplicatePlanButton" Content="План для снятых отметок"/>
      </WrapPanel>
     </StackPanel>
     <TextBlock Name="DuplicatesHint" Grid.Row="1" Margin="0,8" TextWrapping="Wrap" Text="Начните поиск или продолжите сравнение после завершённого обхода. Все копии по умолчанию отмечены «Оставить»." Foreground="#52647F"/>
     <DataGrid Name="DuplicateGroupsGrid" Grid.Row="2" IsReadOnly="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Группа" Binding="{Binding Label}" Width="125"/>
       <DataGridTextColumn Header="Копий" Binding="{Binding Copies}" Width="70"/>
       <DataGridTextColumn Header="Томов" Binding="{Binding Volumes}" Width="70"/>
       <DataGridTextColumn Header="Оценка повтора, MiB" Binding="{Binding DuplicateMiB}" Width="155"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="3" Margin="0,8">
      <Button Name="DuplicateGroupBack" Content="Предыдущие группы"/>
      <Button Name="DuplicateGroupNext" Content="Следующие группы"/>
      <Button Name="DuplicateOpenGroup" Content="Открыть группу"/>
      <Button Name="DuplicateCopyBack" Content="Предыдущие копии"/>
      <Button Name="DuplicateCopyNext" Content="Следующие копии"/>
      <Button Name="DuplicateReferenceButton" Content="Назначить сохраняемой копией"/>
      <Button Name="DuplicateVolumeProposalButton" Content="Предложить отметки для выбранного тома"/>
      <Button Name="DuplicatePreviewButton" Content="Предпросмотр фото"/>
      <TextBlock Name="DuplicatePageText" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </WrapPanel>
     <DataGrid Name="DuplicatesGrid" Grid.Row="4" IsReadOnly="False">
      <DataGrid.Columns>
       <DataGridCheckBoxColumn Header="Оставить" Binding="{Binding Keep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
       <DataGridTextColumn Header="Эталон" Binding="{Binding ReferenceLabel}" Width="70" IsReadOnly="True"/>
       <DataGridTextColumn Header="Диск" Binding="{Binding Drive}" Width="70" IsReadOnly="True"/>
       <DataGridTextColumn Header="MiB" Binding="{Binding MiB}" Width="90" IsReadOnly="True"/>
       <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
       <DataGridTextColumn Header="Отпечаток" Binding="{Binding HashLabel}" Width="115" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Name="OrganizeTab" Header="Порядок и переносы"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Подготовьте порядок — сначала увидите каждый будущий путь" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button Name="PickOrganizationRoot" Content="Откуда…"/><TextBox Name="OrganizationRootBox" MinWidth="180"/></DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,12"><Button Name="PickOrganizationDestination" Content="Куда…"/><TextBox Name="OrganizationDestinationBox" MinWidth="180"/></DockPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal"><Button Name="OrganizePlanButton" Content="Разложить по категориям — план"/><Button Name="RelocatePlanButton" Content="Перенести со структурой — план"/></StackPanel>
    <TextBlock Grid.Row="4" Margin="0,20" TextWrapping="Wrap" Foreground="#52647F" Text="Документы, изображения, видео, аудио, установщики и архивы распределяются по правилам. Имена и вложенные пути сохраняются. Занятые назначения не перезаписываются.&#10;&#10;Этот режим предназначен для пользовательских файлов и архивов. Установленные программы, работающие базы, Git/node_modules и данные приложений со ссылками исключаются. Исходные пустые папки остаются. Для данных приложений нужен отдельный проверенный сценарий остановки и миграции."/>
   </Grid></TabItem>
   <TabItem Name="RulesTab" Header="Правила"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel><Button Name="PolicyLoadButton" Content="Прочитать общие правила"/><Label Content="Путь" Target="{Binding ElementName=PolicyPathBox}"/><TextBox Name="PolicyPathBox" MinWidth="180"/><Label Content="Причина" Target="{Binding ElementName=PolicyReasonBox}"/><TextBox Name="PolicyReasonBox" MinWidth="140"/><Button Name="ProtectButton" Content="Защитить"/><Button Name="ExcludeButton" Content="Не сканировать"/></WrapPanel>
    <TextBlock Grid.Row="1" Margin="0,12" TextWrapping="Wrap" Text="Защита запрещает изменение; исключение ограничивает только скан. Унаследованные правила показаны отдельно. Изменение правил делает старые планы недействительными."/>
    <TabControl Grid.Row="2" Background="White">
     <TabItem Header="Решения этого ПК"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <WrapPanel><ComboBox Name="RuleKindPicker" SelectedIndex="0"><ComboBoxItem Content="Защита" Tag="ProtectedPaths"/><ComboBoxItem Content="Не сканировать" Tag="ScanExclusions"/><ComboBoxItem Content="Повторные разрешения" Tag="CleanupPermissions"/><ComboBoxItem Content="Категории" Tag="OrganizationRules"/></ComboBox><Button Name="RuleAddButton" Content="Добавить строку"/><Button Name="RuleRemoveButton" Content="Удалить / отозвать выбранное"/></WrapPanel>
      <DataGrid Name="EditableRulesGrid" Grid.Row="1" AutoGenerateColumns="True" IsReadOnly="False"/>
      <Button Name="RuleSaveButton" Grid.Row="2" Content="Сохранить с проверкой версии"/>
     </Grid></TabItem>
     <TabItem Header="Действующая защита"><DataGrid Name="ProtectionGrid"><DataGrid.Columns><DataGridTextColumn Header="Защищённый путь" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Причина / источник" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></TabItem>
     <TabItem Header="Экспертный JSON"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox Name="HostPolicyBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/><Button Name="SavePolicyButton" Grid.Row="1" Content="Проверить и сохранить JSON"/></Grid></TabItem>
    </TabControl>
   </Grid></TabItem>
   <TabItem Name="HistoryTab" Header="История"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button Name="HistoryButton" Content="Обновить историю"/><Button Name="LoadPlanButton" Content="Открыть выбранный план"/><Button Name="EventsButton" Content="Показать журнал"/><Button Name="RestoreButton" Content="Подготовить восстановление"/><Button Name="RecoveryInspectButton" Content="Незавершённые фазы"/><Button Name="RecoveryFinishButton" Content="План завершения переноса"/><Button Name="RecoveryCopyButton" Content="План восстановления / карантина копии"/><Button Name="StorageButton" Content="Хранилище"/></WrapPanel>
    <DataGrid Name="HistoryGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Когда (UTC)" Binding="{Binding CreatedUtc}" Width="210"/><DataGridTextColumn Header="Тип" Binding="{Binding TypeLabel}" Width="120"/><DataGridTextColumn Header="Состояние" Binding="{Binding StatusLabel}" Width="150"/><DataGridTextColumn Header="Файлов" Binding="{Binding Count}" Width="90"/><DataGridTextColumn Header="План" Binding="{Binding Id}" Width="*"/></DataGrid.Columns></DataGrid>
    <TabControl Grid.Row="2" MaxHeight="260"><TabItem Header="Объекты и события"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Name="EventDetailButton" Content="Технические данные выбранного события"/><DataGrid Name="HistoryEventsGrid" Grid.Row="1"><DataGrid.Columns><DataGridTextColumn Header="Когда, UTC" Binding="{Binding Utc}" Width="150"/><DataGridTextColumn Header="Действие" Binding="{Binding KindLabel}" Width="140"/><DataGridTextColumn Header="Итог" Binding="{Binding StatusLabel}" Width="120"/><DataGridTextColumn Header="Путь" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Причина / этап" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Итог и технические подробности"><TextBox Name="HistoryDetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
   </Grid></TabItem>
  </TabControl>
  <Expander Name="PlanExpander" Grid.Row="3" Header="План действий — ничего не выполняется без согласования" Margin="18,0,18,8" Background="White" Padding="10">
   <Grid MinHeight="150" MaxHeight="420"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Name="PlanDetailsText" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#52647F"/>
    <TabControl Grid.Row="1" Background="White"><TabItem Header="Операции">    <DataGrid Name="PlanGrid"><DataGrid.Columns><DataGridTextColumn Header="Действие" Binding="{Binding ActionLabel}" Width="135"/><DataGridTextColumn Header="Откуда" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Куда" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="MiB" Binding="{Binding MiB}" Width="85"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Все предупреждения"><DataGrid Name="WarningsGrid"><DataGrid.Columns><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Подробности выбранной строки"><TextBox Name="SelectionDetails" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem></TabControl>
    <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button Name="ApproveButton" Content="Утвердить этот план" IsEnabled="False"/><Button Name="ExecuteButton" Content="Выполнить утверждённый" Background="#2563CF" Foreground="White" IsEnabled="False"/><TextBlock Text="Полный состав файла • правила • журнал • без перезаписи" VerticalAlignment="Center" Foreground="#52647F"/></WrapPanel>
   </Grid>
  </Expander>
  <Border Grid.Row="4" Background="#E7EDF5" Padding="18,7"><StackPanel>
    <TextBlock Name="CoverageText" TextWrapping="Wrap" Foreground="#805000"/>
    <TextBlock Name="ResultStateText" Text="Ещё не запускалось — выберите действие" TextWrapping="Wrap"/>
    <WrapPanel><Button Name="PagePreviousButton" Content="← Страница"/><ComboBox Name="PageKindPicker" SelectedIndex="0"><ComboBoxItem Content="Рост"/><ComboBoxItem Content="Ветка"/><ComboBoxItem Content="План"/><ComboBoxItem Content="Предупреждения"/><ComboBoxItem Content="Диагностика"/><ComboBoxItem Content="Планы истории"/><ComboBoxItem Content="История"/></ComboBox><Button Name="PageNextButton" Content="Страница →"/><TextBlock Name="PageLabel" VerticalAlignment="Center"/><Button Name="DetailsButton" Content="Полный текст выбранной строки"/></WrapPanel>
    <DockPanel><ProgressBar Name="BusyBar" Width="100" Height="10" IsIndeterminate="False" Minimum="0" Maximum="100" Margin="0,0,12,0"/><TextBlock Name="StatusText" Text="Готово. Ни одно действие не запускается автоматически." TextTrimming="CharacterEllipsis"/></DockPanel>
  </StackPanel></Border>
 </Grid>
</Window>
