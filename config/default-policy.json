{
  "SchemaVersion": 1,
  "Revision": 4,
  "ProtectedPaths": [
    { "Path": "{ProjectRoot}", "Scope": "Exact", "Reason": "Не организовывать сам каталог приложения SmartClean" },
    { "Path": "{ProjectRoot}\\ui", "Scope": "Tree", "Reason": "Интерфейс SmartClean" },
    { "Path": "{ProjectRoot}\\config", "Scope": "Tree", "Reason": "Встроенные правила SmartClean" },
    { "Path": "{ProjectRoot}\\SmartClean.exe", "Scope": "Exact", "Reason": "Запускатель SmartClean" },
    { "Path": "{ProjectRoot}\\SmartClean.ps1", "Scope": "Exact", "Reason": "Точка входа SmartClean" },
    { "Path": "{ProjectRoot}\\Worker.ps1", "Scope": "Exact", "Reason": "Рабочий процесс SmartClean" },
    { "Path": "{ProjectRoot}\\settings.json", "Scope": "Exact", "Reason": "Настройки SmartClean" },
    { "Path": "{ProjectRoot}\\modules", "Scope": "Tree", "Reason": "Ядро SmartClean" },
    { "Path": "{ProjectRoot}\\src", "Scope": "Tree", "Reason": "Ядро SmartClean" },
    { "Path": "{ProjectRoot}\\policy", "Scope": "Tree", "Reason": "Политика и журнал решений" },
    { "Path": "{ProjectRoot}\\tools", "Scope": "Tree", "Reason": "Сканеры SmartClean" },
    { "Path": "{ResultsRoot}\\snapshots", "Scope": "Tree", "Reason": "Сохранённые замеры" },
    { "Path": "{Windows}", "Scope": "Tree", "Reason": "Системные файлы Windows" },
    { "Path": "{ProgramFiles}", "Scope": "Tree", "Reason": "Установленные приложения" },
    { "Path": "{ProgramFilesX86}", "Scope": "Tree", "Reason": "Установленные приложения" },
    { "Path": "{LocalAppData}\\Claude-Data", "Scope": "Tree", "Reason": "Рабочие данные и история Claude" },
    { "Path": "{LocalAppData}\\ms-playwright", "Scope": "Tree", "Reason": "Версии браузеров, используемые Codex и проектами" },
    { "Path": "{LocalAppData}\\Temp\\claude", "Scope": "Tree", "Reason": "Рабочие временные данные Claude" },
    { "Path": "{UserProfile}\\.claude", "Scope": "Tree", "Reason": "Настройки и история Claude" },
    { "Path": "{UserProfile}\\.kiro", "Scope": "Tree", "Reason": "Рабочие данные агента" },
    { "Path": "{UserProfile}\\.gradle", "Scope": "Tree", "Reason": "Среда сборки и офлайн-зависимости" },
    { "Path": "{UserProfile}\\.nuget", "Scope": "Tree", "Reason": "Зависимости проектов" },
    { "Path": "{UserProfile}\\.codex", "Scope": "Tree", "Reason": "История и состояние Codex" },
    { "Path": "{UserProfile}\\.vscode", "Scope": "Tree", "Reason": "Рабочие данные редактора" },
    { "Path": "{LocalAppData}\\Temp", "Scope": "Exact", "Reason": "Temp нельзя переносить или удалять целиком" }
  ],
  "ScanExclusions": [],
  "CleanupPermissions": [],
  "OrganizationRules": [
    { "Category": "Документы", "Extensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".csv", ".md"] },
    { "Category": "Изображения", "Extensions": [".jpg", ".jpeg", ".png", ".webp", ".heic", ".gif", ".tif", ".tiff", ".raw"] },
    { "Category": "Видео", "Extensions": [".mp4", ".mov", ".avi", ".mkv", ".webm"] },
    { "Category": "Аудио", "Extensions": [".mp3", ".wav", ".flac", ".m4a", ".ogg"] },
    { "Category": "Установщики", "Extensions": [".exe", ".msi", ".iso", ".msix"] },
    { "Category": "Архивы", "Extensions": [".zip", ".7z", ".rar", ".tar", ".gz"] }
  ],
  "DuplicateExcludedSegments": [".git", "node_modules", "AppData", "Windows", "Program Files", "Program Files (x86)", "WindowsApps", ".codex", ".vscode"],
  "MinimumTempAgeDays": 7,
  "ApprovalHours": 24,
  "MaxPlanFiles": 10000,
  "MaxDiscoveryFiles": 1000000
}
